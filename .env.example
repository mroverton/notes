# ---------------------------------------------------------------------------
# Example environment configuration.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# `.env` is gitignored — never commit real secrets. In production these values
# come from your secrets manager / orchestrator, not a file on disk.
# ---------------------------------------------------------------------------

# --- Postgres (used by the `db` service in docker-compose) ---
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes_password
POSTGRES_DB=notes

# --- Database URL the app connects with ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Host is `db` when running inside docker-compose (the service name),
# or `localhost` when running the app directly on your machine.
DATABASE_URL=postgresql+psycopg://notes:notes_password@db:5432/notes

# Separate database used by the test suite so tests never touch real data.
TEST_DATABASE_URL=postgresql+psycopg://notes:notes_password@localhost:5432/notes_test

# --- Authentication ---
# Secret used to sign JWT access tokens. MUST be long, random, and secret.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# How long an access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
